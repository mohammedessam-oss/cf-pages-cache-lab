/assets/no-cache.json
  Cache-Control: no-store
  X-Cache-Lab: no-cache

/assets/short-cache.json
  Cache-Control: public, max-age=10
  X-Cache-Lab: short-cache

/assets/long-cache.json
  Cache-Control: public, max-age=3600
  X-Cache-Lab: long-cache

/assets/immutable.js
  Cache-Control: public, max-age=31536000, immutable
  X-Cache-Lab: immutable

/assets/swr.json
  Cache-Control: public, max-age=5, stale-while-revalidate=30
  X-Cache-Lab: swr

/assets/private.json
  Cache-Control: private, max-age=60
  X-Cache-Lab: private


